{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "dom"
    ],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "exclude": [],
  "include": [
    "tests/support/core-host.d.ts",
    "hooks/checkpoint.ts",
    "hooks/checkpoint-validation.ts",
    "hooks/evidence.ts",
    "hooks/prepare.ts",
    "hooks/config.ts",
    "hooks/state.ts",
    "hooks/preparation-control.ts",
    "hooks/evidence-packet.ts",
    "hooks/failure.ts"
  ]
}
